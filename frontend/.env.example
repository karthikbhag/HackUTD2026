# Copy this file to frontend/.env.local and fill in local values.
# .env.local is ignored by Git. Never commit real keys or tokens.

# --- SpacetimeDB (leave both unset and use /demo for the fictional UI fixtures) ---
# Public values: NEXT_PUBLIC_ variables are bundled into browser JavaScript.
NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3100
NEXT_PUBLIC_SPACETIMEDB_DATABASE=riskreach-person3-demo

# --- Google Maps / routing: separate restricted Google keys; never commit actual values ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is also accepted for the browser key.
NEXT_PUBLIC_ROUTING_WORKER_URL=http://localhost:3201

# --- Gemini (server-only) ---
# Secret. Never add a NEXT_PUBLIC_ prefix to these: that would ship the key to every browser.
# Create a free-tier key in Google AI Studio. Free-tier prompts may be used by Google
# to improve its products, so send only synthetic scenario data.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash (stable Flash with a free tier).
GEMINI_MODEL=

# --- AI review budget (optional; defaults protect the free tier) ---
# Raise these on a paid plan; 0 turns a limit off. Counters reset when the server restarts.
# Daily limits reset at midnight Pacific, like Google's quotas. Output cap includes thinking tokens.
# Cache reuses reviews for unchanged evidence. Thinking: minimal|low|medium|high, or "default"
# (keep the model's own level, e.g. for models without "minimal").
# GEMINI_REVIEW_MAX_PER_MINUTE=5
# GEMINI_REVIEW_MAX_PER_DAY=50
# GEMINI_REVIEW_MAX_TOKENS_PER_DAY=100000
# GEMINI_REVIEW_MAX_OUTPUT_TOKENS=1024
# GEMINI_REVIEW_CACHE_MINUTES=30
# GEMINI_THINKING_LEVEL=minimal
# Follow-up questions share the limits above. Per-review follow-up count and answer cap:
# GEMINI_CHAT_MAX_TURNS=6
# GEMINI_CHAT_MAX_OUTPUT_TOKENS=512

# Development only: force an AI review/follow-up error to test the UI (rate_limit | api_error | timeout | invalid_response).
# Leave unset normally. Ignored in production builds.
GEMINI_REVIEW_SIMULATE_ERROR=
