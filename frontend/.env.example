# Copy this file to frontend/.env.local and fill in local values.
# .env.local is ignored by Git. Never commit real keys or tokens.

# --- SpacetimeDB (optional; leave both unset to use the fictional UI fixtures) ---
# Public values: NEXT_PUBLIC_ variables are bundled into browser JavaScript.
NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3100
NEXT_PUBLIC_SPACETIMEDB_DATABASE=riskreach-local

# --- Gemini (server-only) ---
# Secret. Never add a NEXT_PUBLIC_ prefix to these: that would ship the key to every browser.
# Create a free-tier key in Google AI Studio. Free-tier prompts may be used by Google
# to improve its products, so send only synthetic scenario data.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash (stable Flash with a free tier).
GEMINI_MODEL=
